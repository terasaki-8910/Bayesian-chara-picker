state/
*.log
.DS_Store
node_modules/
__pycache__/
dist/
coverage/
# secrets -- never commit. build does `git add -A`, so an untracked .env WOULD be committed.
.env
.env.*
!.env.example

# Playwright
/test-results/
/playwright-report/
/blob-report/
.playwright-mcp/

# DLsite 収集の生の取得物 (HTML は肥大かつ再取得可能・著作物のため追跡しない).
# data/characters.json と data/supply.json 本体、tests/fixtures/ の固定 HTML
# フィクスチャは追跡する (worktree 必須 + レビュー履歴に価値がある).
/data/raw/

# Vite
.vite/
*.tsbuildinfo

# パッケージマネージャは npm 固定（scripts/gates.sh が npm を直接叩く）。
# worktree で誤って `pnpm install` されたロックファイルが紛れ込んだことがあるので
# 明示的に無視する。
pnpm-lock.yaml

# state/gates/* がフィーチャ単位の tsc を回すために一時生成する tsconfig。
# ゲート側で必ず削除するが、途中で中断した場合に取り残されるのを追跡しない。
/.tsconfig-gate.json

# Claude Code の個人用のローカル設定（PC ごとに違う。コミットしない）
.claude/settings.local.json
